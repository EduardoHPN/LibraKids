# Copie para .env e preencha com os valores reais. O .env NÃO é versionado.

# Banco PostgreSQL (Supabase). Use a connection string do *Session pooler*
# (host *.pooler.supabase.com, porta 5432) e mantenha sslmode=require.
# Sem DATABASE_URL, a API usa SQLite local em instance/site.db (só desenvolvimento).
DATABASE_URL=postgresql://postgres.<ref>:<senha>@<host-do-pooler>:5432/postgres?sslmode=require
